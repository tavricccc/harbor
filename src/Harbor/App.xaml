<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Harbor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Harbor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Pane.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Replaced at launch by the language's Noto Sans fallback list (Services/UiFont). -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft JhengHei UI</FontFamily>
            <!-- Older view keys, drawn in Pane's type scale and colors. -->
            <Style x:Key="CompactPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PaneSectionTitle}"/>
            <Style x:Key="CompactSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource PaneText1Brush}"/>
            </Style>
            <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource PaneText2Brush}"/>
            </Style>
            <Style x:Key="DownloadFooterStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="BorderBrush" Value="{ThemeResource PaneStrokeBrush}"/>
                <Setter Property="Padding" Value="20,12"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
