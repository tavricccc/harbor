<Page x:Class="Harbor.Views.DownloadProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Harbor.Localization"
      FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Padding="24,20,24,16" Spacing="12">
                <InfoBar x:Name="Error" Severity="Error" Visibility="Collapsed" Closed="HideError"/>
                <TextBlock x:Name="FileName" FontSize="14" VerticalAlignment="Center" MaxLines="1"
                               TextTrimming="CharacterEllipsis" DragStarting="DragFile"/>
                <HyperlinkButton x:Name="SourceLink" Click="OpenSource" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="{loc:Localize Key=Common.SourceUrl}">
                    <TextBlock x:Name="Source" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    <HyperlinkButton.ContextFlyout>
                        <MenuFlyout><MenuFlyoutItem Text="{loc:Localize Key=Common.CopyUrl}" Click="CopySource"/></MenuFlyout>
                    </HyperlinkButton.ContextFlyout>
                </HyperlinkButton>
                <TextBlock x:Name="Folder" FontSize="12" Foreground="{ThemeResource PaneText2Brush}"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
                <Grid x:Name="Metrics" ColumnSpacing="12" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Transfer" FontSize="12" Foreground="{ThemeResource PaneText2Brush}"/>
                    <TextBlock x:Name="Speed" Grid.Column="1" FontSize="12" HorizontalAlignment="Center" AutomationProperties.Name="{loc:Localize Key=Progress.SpeedName}"/>
                    <TextBlock x:Name="Remaining" Grid.Column="2" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{ThemeResource PaneText2Brush}" AutomationProperties.Name="{loc:Localize Key=Progress.RemainingName}"/>
                </Grid>
                <StackPanel x:Name="ProgressSection" Spacing="12">
                    <ProgressBar x:Name="Progress" Maximum="100" IsIndeterminate="False" Margin="0,2,0,2" AutomationProperties.Name="{loc:Localize Key=Downloads.Progress}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource PaneText2Brush}"/>
                        <TextBlock x:Name="Percent" Grid.Column="1" FontSize="12" Foreground="{ThemeResource PaneText2Brush}"/>
                    </Grid>
                </StackPanel>
                <CheckBox x:Name="CloseAfterOpen" Visibility="Collapsed" Content="{loc:Localize Key=Progress.CloseAfterOpen}" AutomationProperties.AutomationId="CloseProgressAfterOpen"
                          Checked="SaveClosePreference" Unchecked="SaveClosePreference"/>
                <Border x:Name="ConnectionsSurface" Visibility="Collapsed" BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource PaneStrokeBrush}" Padding="0,16,0,0">
                    <ContentPresenter x:Name="ConnectionsHost"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="Footer" Grid.Row="1" Style="{StaticResource DownloadFooterStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ConnectionsToggle" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PaneSubtleButton}"
                        Click="ToggleConnections" AutomationProperties.AutomationId="ToggleConnectionProgress"
                        AutomationProperties.Name="{loc:Localize Key=Progress.ConnectionsTitle}" ToolTipService.ToolTip="{loc:Localize Key=Progress.ConnectionsTitle}">
                    <FontIcon x:Name="ConnectionsArrow" Glyph="&#xE70D;" FontSize="12"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Browse" Content="{loc:Localize Key=Common.OpenFolder}" Visibility="Collapsed" Click="BrowseClick" AutomationProperties.AutomationId="ProgressOpenFolder"/>
                    <Button x:Name="StopSeed" Content="{loc:Localize Key=Downloads.StopSeeding}" Visibility="Collapsed" Click="StopSeedClick"/>
                    <Button x:Name="Primary" Content="{loc:Localize Key=Progress.Connecting}" IsEnabled="False" Click="PrimaryClick" AutomationProperties.AutomationId="ProgressPrimary"/>
                    <Button x:Name="Cancel" Content="{loc:Localize Key=Common.Cancel}" IsEnabled="False" Click="CancelClick" AutomationProperties.AutomationId="CancelProgress"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
