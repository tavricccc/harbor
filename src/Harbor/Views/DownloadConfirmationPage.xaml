<Page x:Class="Harbor.Views.DownloadConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CancelShortcut"/>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="StartShortcut"/>
    </Page.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentPresenter x:Name="FormHost" Margin="24,20,24,16"/>
        <Border x:Name="Footer" Grid.Row="1" Style="{StaticResource DownloadFooterStyle}">
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel" AutomationProperties.AutomationId="CancelDownload"/>
                <Button x:Name="LaterButton" Content="稍後下載" Click="DownloadLater" ToolTipService.ToolTip="保存到待下載清單，現在不開始下載"/>
                <Button x:Name="ScheduleButton" Content="排程…">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="12" MinWidth="280">
                                <TextBlock Text="定時開始下載" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <CalendarDatePicker x:Name="ScheduleDate" Header="日期"/>
                                <TimePicker x:Name="ScheduleTime" Header="時間" ClockIdentifier="24HourClock"/>
                                <Button Content="加入排程" Click="ScheduleDownload" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="StartButton" Content="檢查連結"
                        Style="{StaticResource AccentButtonStyle}" Click="Start" AutomationProperties.AutomationId="StartDownload"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
