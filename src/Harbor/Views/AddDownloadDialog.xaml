<ContentDialog x:Class="Harbor.Views.AddDownloadDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Harbor.Localization"
               Title="{loc:Localize Key=Downloads.Add}" PrimaryButtonText="{loc:Localize Key=Download.CheckLink}" CloseButtonText="{loc:Localize Key=Common.Cancel}"
               DefaultButton="Primary" PrimaryButtonClick="Submit"
               FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">660</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
    </ContentDialog.Resources>
</ContentDialog>
