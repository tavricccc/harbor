<?xml version="1.0" encoding="utf-8"?>
<!--
  Pane's design tokens and control styles for Harbor's glass windows: text, stroke and fill colors per theme,
  radii (panel 20, item 12, control 10), control heights (24 / 28 / 32 / 40) and the accent (霧藍).
  The font is Noto Sans when installed, otherwise the Windows UI font for the language (Services/UiFont).
-->
