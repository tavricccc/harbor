<Page x:Class="Harbor.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="using:Harbor.Localization"
      xmlns:models="using:Harbor.Models"
      xmlns:controls="using:Harbor.Controls"
      FontSize="13" Background="Transparent"
      AllowDrop="True" DragOver="DownloadDragOver" Drop="DownloadDrop">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewShortcut"/>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteShortcut"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchShortcut"/>
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllShortcut"/>
        <KeyboardAccelerator Key="Delete" Invoked="DeleteShortcut"/>
        <KeyboardAccelerator Key="Enter" Invoked="OpenShortcut"/>
        <KeyboardAccelerator Key="F5" Invoked="RefreshShortcut"/>
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the window drags from here; the buttons stay clickable. -->
        <Grid x:Name="TitleBarArea" Height="52" Padding="20,0,10,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="20" Height="20"/>
                <TextBlock Text="Harbor" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource UiText1Brush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="BackToDownloads" Click="ShowDownloads" Visibility="Collapsed" Padding="8,0,12,0"
                    AutomationProperties.Name="{loc:Localize Key=Downloads.List}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Glyph="back" Width="14" Height="14"/>
                    <TextBlock Text="{loc:Localize Key=Downloads.List}"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="DownloadsCommands" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource UiAccentButton}" Click="AddDownload" Height="28" Margin="0,0,6,0" Padding="10,0,12,0"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" AutomationProperties.AutomationId="AddDownload"
                        AutomationProperties.Name="{loc:Localize Key=Downloads.Add}" ToolTipService.ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:Icon Glyph="plus" Width="13" Height="13"/>
                        <TextBlock Text="{loc:Localize Key=Downloads.Add}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource UiIconButton}" Click="PasteDownload" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        AutomationProperties.Name="{loc:Localize Key=Downloads.Paste}" ToolTipService.ToolTip="{loc:Localize Key=Downloads.Paste}">
                    <controls:Icon Glyph="clipboard" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource UiIconButton}" AutomationProperties.Name="{loc:Localize Key=Common.MoreOptions}"
                        ToolTipService.ToolTip="{loc:Localize Key=Common.MoreOptions}">
                    <controls:Icon Glyph="more" Width="16" Height="16"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{loc:Localize Key=Downloads.OpenTorrent}" Click="OpenTorrent" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{loc:Localize Key=Downloads.ResumeAll}" Click="ResumeAll" IsEnabled="{x:Bind ViewModel.CanResumeAll, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="{loc:Localize Key=Downloads.PauseAll}" Click="PauseAll" IsEnabled="{x:Bind ViewModel.CanPauseAll, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="{loc:Localize Key=Downloads.ClearCompleted}" Click="ClearCompleted" IsEnabled="{x:Bind ViewModel.CanClearCompleted, Mode=OneWay}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{loc:Localize Key=Browser.Integration}" Click="OpenBrowserSetup"/>
                            <MenuFlyoutItem Text="{loc:Localize Key=Extensions.Title}" Click="ShowExtensions" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource UiIconButton}" Click="ShowSettings" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        AutomationProperties.AutomationId="SettingsItem" AutomationProperties.Name="{loc:Localize Key=Common.Settings}"
                        ToolTipService.ToolTip="{loc:Localize Key=Common.Settings}">
                    <controls:Icon Glyph="gear" Width="16" Height="16"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Padding="10,0,0,0"
                        BorderBrush="{ThemeResource UiStrokeBrush}" BorderThickness="1,0,0,0">
                <Button Style="{StaticResource UiIconButton}" Click="MinimizeClicked" AutomationProperties.Name="{loc:Localize Key=Common.Minimize}">
                    <controls:Icon Glyph="minus" Width="16" Height="16"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource UiIconButton}" Click="MaximizeClicked" AutomationProperties.Name="{loc:Localize Key=Common.Maximize}">
                    <controls:Icon x:Name="MaximizeIcon" Glyph="maximize" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource UiIconButton}" Click="CloseClicked" AutomationProperties.Name="{loc:Localize Key=Common.Close}">
                    <controls:Icon Glyph="close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DownloadsTop" Grid.Row="1" Padding="20,0,20,0" Spacing="10">
            <!-- A hint card rather than an InfoBar: its action and close button stay centered on the text. -->
            <Border x:Name="BrowserSetupHint" Visibility="Collapsed" CornerRadius="12" Padding="16,10,8,10"
                    Background="{ThemeResource UiFillControlBrush}" BorderBrush="{ThemeResource UiStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:Icon Glyph="globe" Width="16" Height="16" VerticalAlignment="Center" Foreground="{ThemeResource UiAccentBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{loc:Localize Key=Browser.HintTitle}" FontWeight="SemiBold" Foreground="{ThemeResource UiText1Brush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Localize Key=Browser.HintMessage}" FontSize="12" Foreground="{ThemeResource UiText2Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource UiAccentButton}" Height="28" VerticalAlignment="Center"
                            Content="{loc:Localize Key=Browser.Setup}" Click="OpenBrowserSetup"/>
                    <Button Grid.Column="3" Style="{StaticResource UiIconButton}" VerticalAlignment="Center" Click="BrowserSetupHintClosed"
                            AutomationProperties.Name="{loc:Localize Key=Common.Close}" ToolTipService.ToolTip="{loc:Localize Key=Common.Close}">
                        <controls:Icon Glyph="close" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" Visibility="Collapsed"/>
            <Grid x:Name="Toolbar" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MaxWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:Segmented x:Name="FilterSegment" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Localize Key=Downloads.FilterName}"/>
                <Grid Grid.Column="2" Width="240">
                    <TextBox x:Name="SearchBox" PlaceholderText="{loc:Localize Key=Downloads.SearchPlaceholder}" Padding="32,6,10,5"
                             TextChanged="SearchChanged" AutomationProperties.AutomationId="DownloadSearch"
                             AutomationProperties.Name="{loc:Localize Key=Downloads.SearchName}"/>
                    <controls:Icon Glyph="search" Width="14" Height="14" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{ThemeResource UiText3Brush}"/>
                </Grid>
                <Button Grid.Column="3" Height="32" Width="32" Padding="0" AutomationProperties.AutomationId="DownloadSort"
                        AutomationProperties.Name="{loc:Localize Key=Downloads.SortName}" ToolTipService.ToolTip="{loc:Localize Key=Downloads.SortName}">
                    <controls:Icon Glyph="sort" Width="14" Height="14" Foreground="{ThemeResource UiText2Brush}"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem Text="{loc:Localize Key=Downloads.Newest}" Tag="newest" GroupName="Sort" IsChecked="True" Click="SortClicked"/>
                            <RadioMenuFlyoutItem Text="{loc:Localize Key=Downloads.Oldest}" Tag="oldest" GroupName="Sort" Click="SortClicked"/>
                            <RadioMenuFlyoutItem Text="{loc:Localize Key=Downloads.NameSort}" Tag="name" GroupName="Sort" Click="SortClicked"/>
                            <RadioMenuFlyoutItem Text="{loc:Localize Key=Downloads.FileSize}" Tag="size" GroupName="Sort" Click="SortClicked"/>
                            <RadioMenuFlyoutItem Text="{loc:Localize Key=Downloads.Progress}" Tag="progress" GroupName="Sort" Click="SortClicked"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>

        <Grid x:Name="DownloadsSurface" Grid.Row="2">
            <ListView x:Name="DownloadList" ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}"
                      SelectionMode="Extended" SelectionChanged="DownloadSelectionChanged" DoubleTapped="ListDoubleTapped"
                      Padding="12,0,12,8" ItemContainerStyle="{StaticResource UiListItem}"
                      ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="DownloadList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Grid ColumnSpacing="14" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{ThemeResource UiFillControlBrush}" BorderBrush="{ThemeResource UiStrokeBrush}" BorderThickness="1">
                                <controls:Icon Glyph="{x:Bind FileGlyph, Mode=OneWay}" Width="16" Height="16" Foreground="{ThemeResource UiText2Brush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="{ThemeResource UiText1Brush}"/>
                                <TextBlock Text="{x:Bind SubText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="{ThemeResource UiText3Brush}"/>
                            </StackPanel>
                            <Grid Grid.Column="2" ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" CornerRadius="2" MinHeight="4"
                                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind RowProgressText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource UiText2Brush}"/>
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{x:Bind RowSpeedText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{ThemeResource UiText2Brush}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Tag="{x:Bind Id}" Click="RowPrimary" Style="{StaticResource UiIconButton}"
                                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind PrimaryActionLabel, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind PrimaryActionLabel, Mode=OneWay}">
                                    <controls:Icon Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}" Width="15" Height="15"/>
                                </Button>
                                <Button Tag="{x:Bind Id}" Click="RowFolder" Style="{StaticResource UiIconButton}"
                                        Visibility="{x:Bind FolderVisibility, Mode=OneWay}"
                                        AutomationProperties.Name="{loc:Localize Key=Common.RevealFile}" ToolTipService.ToolTip="{loc:Localize Key=Common.RevealFile}">
                                    <controls:Icon Glyph="folder" Width="15" Height="15"/>
                                </Button>
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind PrimaryActionLabel, Mode=OneWay}" Click="ContextPrimary" IsEnabled="{x:Bind CanAct, Mode=OneWay}" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Common.RevealFile}" Click="ContextFolder" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanReveal, Mode=OneWay}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Downloads.Progress}" Click="ContextProgress" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanReveal, Mode=OneWay}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Downloads.FilesDetails}" Click="ContextDetails" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Downloads.StopSeeding}" Click="ContextPause" Visibility="{x:Bind SeedVisibility, Mode=OneWay}" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Schedule.Edit}" Click="EditSchedule" IsEnabled="{x:Bind IsDeferred, Mode=OneWay}" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Source.Edit}" Click="ContextEditSource" IsEnabled="{x:Bind CanEditSource, Mode=OneWay}" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Source.UseNextLink}" Click="ContextListenSource" IsEnabled="{x:Bind CanEditSource, Mode=OneWay}" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Downloads.Redownload}" Click="ContextRedownload" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Common.CopyUrl}" Click="ContextCopy" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="{loc:Localize Key=Common.Remove}" Click="ContextDelete" Tag="{x:Bind Id}"/>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="24" MaxWidth="420" Margin="0,0,0,40">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource UiText1Brush}"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource UiText2Brush}"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="SettingsFrame" Grid.Row="1" Grid.RowSpan="2" Margin="20,0,20,12" Visibility="Collapsed"/>

        <!-- Status bar: the summary, and actions for the selection while there is one. -->
        <Grid x:Name="StatusBar" Grid.Row="3" Height="44" Padding="20,0,14,0" BorderBrush="{ThemeResource UiStrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource UiText2Brush}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Button Content="{loc:Localize Key=Common.Resume}" Click="ResumeSelected" Visibility="{x:Bind ViewModel.CanResumeSelected, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Localize Key=Downloads.ResumeHint}"/>
                <Button Content="{loc:Localize Key=Common.Pause}" Click="PauseSelected" Visibility="{x:Bind ViewModel.CanPauseSelected, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:Localize Key=Downloads.PauseHint}"/>
                <Button Content="{loc:Localize Key=Common.Remove}" Click="DeleteSelected" ToolTipService.ToolTip="{loc:Localize Key=Downloads.RemoveHint}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
