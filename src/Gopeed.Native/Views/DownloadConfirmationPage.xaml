<Page x:Class="Gopeed_Native.Views.DownloadConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CancelShortcut"/>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="StartShortcut"/>
    </Page.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentPresenter x:Name="FormHost" Margin="24,20,24,16"/>
        <Border x:Name="Footer" Grid.Row="1" Style="{StaticResource DownloadFooterStyle}">
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel" AutomationProperties.AutomationId="CancelDownload"/>
                <Button x:Name="StartButton" Content="檢查連結"
                        Style="{StaticResource AccentButtonStyle}" Click="Start" AutomationProperties.AutomationId="StartDownload"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
